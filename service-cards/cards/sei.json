{
  "schema": "pocket-service-card/v1",
  "description": "Sei mainnet (pacific-1) JSON-RPC (EVM chain id 1329). Parallelized EVM on Cosmos SDK; EVM JSON-RPC on :8545, Cosmos REST on :1317; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    },
    {
      "type": "REST",
      "intent": "expected",
      "backend_hint": "cosmos REST (gRPC-gateway), default :1317"
    },
    {
      "type": "COMET_BFT",
      "intent": "optional",
      "backend_hint": "CometBFT RPC, default :26657 (URI style, /status)"
    },
    {
      "type": "GRPC",
      "intent": "optional",
      "backend_hint": "cosmos gRPC, default :9090"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe",
    "cosmos-rest",
    "cometbft-rpc"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "api": "ethereum-json-rpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    },
    {
      "kind": "openapi",
      "api": "cometbft-rpc",
      "url": "https://raw.githubusercontent.com/sei-protocol/sei-chain/main/sei-tendermint/rpc/openapi/openapi.yaml",
      "notes": "Covers COMET_BFT (URI style on :26657) and CometBFT's own JSON-RPC envelope and /websocket on that port. JSON_RPC and WEBSOCKET on this service are the EVM endpoint (:8545), covered by the ethereum-json-rpc entry."
    },
    {
      "kind": "openapi",
      "api": "cosmos-rest",
      "url": "https://raw.githubusercontent.com/sei-protocol/sei-chain/main/docs/swagger-ui/swagger.yml"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "seid full node with the EVM JSON-RPC enabled (:8545 HTTP, :8546 WS). Sub-second finality; keep the node at tip.",
    "implementations": [
      "sei-chain (seid) >= 5.9"
    ],
    "docs": "https://github.com/sei-protocol/sei-chain",
    "sync": "full",
    "min_disk_gb": 1500,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x531$"
        }
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      },
      {
        "rpc_type": "COMET_BFT",
        "request": {
          "path": "/status",
          "method": "GET"
        },
        "expect": {
          "json_path": "$.result.node_info.network",
          "matches": "^pacific-1$"
        }
      },
      {
        "rpc_type": "REST",
        "request": {
          "path": "/cosmos/base/tendermint/v1beta1/syncing",
          "method": "GET"
        },
        "expect": {
          "json_path": "$.syncing",
          "matches": "^false$"
        }
      }
    ],
    "notes": "JSON_RPC on this service is the EVM endpoint (:8545), not CometBFT; CometBFT is COMET_BFT. eth_syncing is not supported by the Sei EVM RPC; use eth_blockNumber lag against a reference instead."
  },
  "docs": "https://docs.sei.io/",
  "updated": "2026-09-03"
}
