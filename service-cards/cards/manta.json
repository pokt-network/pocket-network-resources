{
  "schema": "pocket-service-card/v1",
  "description": "Manta Pacific mainnet JSON-RPC (chain id 169). OP Stack L2 with Celestia DA; EVM-compatible; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "optional",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Manta Pacific op-geth plus op-node with an Ethereum L1 endpoint.",
    "implementations": [
      "op-geth + op-node (Manta-Network/manta-pacific release)"
    ],
    "sync": "full",
    "min_disk_gb": 500,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0xa9$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ]
  },
  "docs": "https://docs.manta.network/",
  "updated": "2026-09-01"
}
