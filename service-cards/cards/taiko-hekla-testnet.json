{
  "schema": "pocket-service-card/v1",
  "description": "Taiko Hekla testnet JSON-RPC (chain id 167009). Deprecated Taiko testnet; EVM-equivalent.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "deprecated",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "deprecated",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Taiko simple-taiko-node pointed at Hekla with a Holesky L1 endpoint.",
    "implementations": [
      "taiko-geth + taiko-client (simple-taiko-node)"
    ],
    "sync": "full",
    "min_disk_gb": 300,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x28c61$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Testnet. Hekla is deprecated upstream and has 4 suppliers; expect it to be sunset."
  },
  "docs": "https://docs.taiko.xyz/",
  "updated": "2026-09-01"
}
