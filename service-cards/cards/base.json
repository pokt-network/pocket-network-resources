{
  "schema": "pocket-service-card/v1",
  "description": "Base mainnet JSON-RPC (chain id 8453). OP Stack L2 on Ethereum; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "OP Stack execution client (op-geth or op-reth) with op-node connected to an Ethereum L1 endpoint.",
    "implementations": [
      "op-geth (base fork) + op-node >= 1.9",
      "op-reth >= 1.0"
    ],
    "sync": "archive",
    "min_disk_gb": 3000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x2105$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0x3304E22DDaa22bCdC5fCa2269b418046aE7b566A",
            "0x44bb50"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x235d852383386$"
        },
        "notes": "Archival probe: historical balance at block 4504400. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 4,504,400). Unsafe head may lag the sequencer briefly; eth_syncing must still be false."
  },
  "docs": "https://docs.base.org/",
  "updated": "2026-09-01"
}
