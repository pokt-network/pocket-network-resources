{
  "schema": "pocket-service-card/v1",
  "description": "Berachain mainnet JSON-RPC (chain id 80094). EVM-identical execution layer under BeaconKit consensus; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Any stock Ethereum execution client (reth or geth) driven by a beacon-kit consensus node.",
    "implementations": [
      "beacon-kit >= 1.1 + reth >= 1.0",
      "beacon-kit >= 1.1 + geth >= 1.14"
    ],
    "docs": "https://docs.berachain.com/nodes/quickstart",
    "sync": "archive",
    "min_disk_gb": 1000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x138de$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0x6969696969696969696969696969696969696969",
            "0x1e8480"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x1006008cb3f7fd70df2ab5$"
        },
        "notes": "Archival probe: historical balance at block 2000000. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 2,000,000). Execution client is unmodified; all chain-specific config lives in beacon-kit."
  },
  "docs": "https://docs.berachain.com/",
  "updated": "2026-09-01"
}
