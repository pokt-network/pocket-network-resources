{
  "schema": "pocket-service-card/v1",
  "description": "Fantom Opera mainnet JSON-RPC (chain id 250). Lachesis aBFT EVM chain; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "optional",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "go-opera full node. Sonic Labs maintains Opera in maintenance mode; see the sonic service for the successor chain.",
    "implementations": [
      "go-opera >= 1.1 (Sonic-era release)"
    ],
    "docs": "https://github.com/Fantom-foundation/go-opera",
    "sync": "archive",
    "min_disk_gb": 2000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0xfa$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0xaabf86ab3646a7064aa2f61e5959e39129ca46b6",
            "0x6982028"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0xe274153fc265324$"
        },
        "notes": "Archival probe: historical balance at block 110633000. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 110633000)."
  },
  "docs": "https://docs.fantom.foundation/",
  "updated": "2026-09-01"
}
