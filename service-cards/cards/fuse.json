{
  "schema": "pocket-service-card/v1",
  "description": "Fuse mainnet JSON-RPC (chain id 122). EVM-compatible PoS chain; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Fuse full node (Nethermind with the Fuse chainspec).",
    "implementations": [
      "nethermind (fuse config)",
      "openethereum (legacy)"
    ],
    "sync": "full",
    "min_disk_gb": 800,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x7a$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archival verification pending in the gateway config."
  },
  "docs": "https://docs.fuse.io/",
  "updated": "2026-09-01"
}
