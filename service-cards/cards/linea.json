{
  "schema": "pocket-service-card/v1",
  "description": "Linea mainnet JSON-RPC (chain id 59144). zkEVM rollup by Consensys; EVM-equivalent with linea_ namespace; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "optional",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe",
    "linea-json-rpc"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "api": "ethereum-json-rpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    },
    {
      "kind": "docs",
      "api": "linea-json-rpc",
      "url": "https://docs.linea.build/api/reference",
      "notes": "No machine-readable spec is published for this API; this is the canonical human-readable method reference."
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Linea Besu follower node with the Linea plugins, synced from the sequencer.",
    "implementations": [
      "linea-besu >= 24.x",
      "linea-geth (deprecated)"
    ],
    "docs": "https://docs.linea.build/get-started/how-to/run-a-node",
    "sync": "archive",
    "min_disk_gb": 1500,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0xe708$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0xf89d7b9c864f589bbf53a82105107622b35eaa40",
            "0x989680"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x131b06ed22b67549a58$"
        },
        "notes": "Archival probe: historical balance at block 10000000. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 10000000)."
  },
  "docs": "https://docs.linea.build/",
  "updated": "2026-09-03"
}
