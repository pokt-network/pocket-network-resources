{
  "schema": "pocket-service-card/v1",
  "description": "Taiko Alethia mainnet JSON-RPC (chain id 167000). Based rollup on Ethereum; EVM-equivalent; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "optional",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Taiko simple-taiko-node (taiko-geth + taiko-client) with an Ethereum L1 execution and beacon endpoint.",
    "implementations": [
      "taiko-geth + taiko-client (simple-taiko-node)"
    ],
    "docs": "https://github.com/taikoxyz/simple-taiko-node",
    "sync": "archive",
    "min_disk_gb": 1000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x28c58$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0x1670000000000000000000000000000000000001",
            "0x298b3"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x33b2d17896ccc8bbcb6f73b$"
        },
        "notes": "Archival probe: historical balance at block 170163. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 170163)."
  },
  "docs": "https://docs.taiko.xyz/",
  "updated": "2026-09-01"
}
