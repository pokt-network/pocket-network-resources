{
  "schema": "pocket-service-card/v1",
  "description": "Sonic mainnet JSON-RPC (chain id 146). Fantom successor by Sonic Labs; EVM-compatible; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "optional",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Sonic full node (sonicd) run without validator keys.",
    "implementations": [
      "sonicd >= 2.0"
    ],
    "sync": "archive",
    "min_disk_gb": 1500,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x92$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0xfc00face00000000000000000000000000000000",
            "0xa4537f"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x3be6de067d592077ea6bc6b$"
        },
        "notes": "Archival probe: historical balance at block 10769279. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 10769279)."
  },
  "docs": "https://docs.soniclabs.com/",
  "updated": "2026-09-01"
}
