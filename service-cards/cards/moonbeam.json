{
  "schema": "pocket-service-card/v1",
  "description": "Moonbeam mainnet JSON-RPC (chain id 1284). Polkadot parachain with Frontier EVM; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "moonbeam RPC, default :9944"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "moonbeam WS, default :9944",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "api": "ethereum-json-rpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Moonbeam collator binary run as a full node with the Ethereum RPC enabled (:9944 serves HTTP and WS).",
    "implementations": [
      "moonbeam >= 0.40 (--chain moonbeam)"
    ],
    "docs": "https://docs.moonbeam.network/node-operators/networks/run-a-node/overview/",
    "sync": "full",
    "min_disk_gb": 1000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x504$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Substrate node: HTTP and WS share :9944. Archival verification pending in the gateway config."
  },
  "docs": "https://docs.moonbeam.network/",
  "updated": "2026-09-03"
}
