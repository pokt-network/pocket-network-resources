{
  "schema": "pocket-service-card/v1",
  "description": "XRPL EVM Sidechain testnet JSON-RPC (chain id 1449000). Cosmos SDK + evmOS chain; EVM JSON-RPC on :8545.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    },
    {
      "type": "REST",
      "intent": "optional",
      "backend_hint": "cosmos REST (gRPC-gateway), default :1317"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "exrpd full node on the testnet with the JSON-RPC server enabled.",
    "implementations": [
      "exrpd (xrplevm node) >= 8.0"
    ],
    "docs": "https://docs.xrplevm.org/pages/operators",
    "sync": "full",
    "min_disk_gb": 300,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x161c28$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Testnet."
  },
  "docs": "https://docs.xrplevm.org/",
  "updated": "2026-09-01"
}
