{
  "schema": "pocket-service-card/v1",
  "description": "ZKsync Era mainnet JSON-RPC (chain id 324). ZK rollup on Ethereum; EVM-compatible with zks_ extensions; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe",
    "zksync-zks-json-rpc"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "api": "ethereum-json-rpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    },
    {
      "kind": "docs",
      "api": "zksync-zks-json-rpc",
      "url": "https://docs.zksync.io/zksync-protocol/api/zks-rpc",
      "notes": "No machine-readable spec is published for this API; this is the canonical human-readable method reference."
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "ZKsync Era external node (EN) synced from the main node via snapshot recovery, with an Ethereum L1 endpoint.",
    "implementations": [
      "zksync-era external node >= 25.0"
    ],
    "docs": "https://github.com/matter-labs/zksync-era/blob/main/docs/src/guides/external-node/01_intro.md",
    "sync": "full",
    "min_disk_gb": 1500,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x144$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Not a geth fork: run the ZKsync external node. Archival verification pending in the gateway config."
  },
  "docs": "https://docs.zksync.io/",
  "updated": "2026-09-03"
}
