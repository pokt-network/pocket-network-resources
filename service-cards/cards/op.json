{
  "schema": "pocket-service-card/v1",
  "description": "OP Mainnet JSON-RPC (chain id 10). OP Stack L2 on Ethereum; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "api": "ethereum-json-rpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "OP Stack execution client (op-geth or op-reth) with op-node connected to an Ethereum L1 endpoint.",
    "implementations": [
      "op-geth + op-node >= 1.9",
      "op-reth >= 1.0"
    ],
    "docs": "https://docs.optimism.io/operators/node-operators/rollup-node",
    "sync": "archive",
    "min_disk_gb": 3000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0xa$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0xacD03D601e5bB1B275Bb94076fF46ED9D753435A",
            "0x7bedc8"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x12e28e5ddc49828$"
        },
        "notes": "Archival probe: historical balance at block 8121800. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 8121800). Pre-Bedrock history (before block 105,235,063) needs the legacy l2geth archive; most consumers do not require it."
  },
  "docs": "https://docs.optimism.io/",
  "updated": "2026-09-03"
}
