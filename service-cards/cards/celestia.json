{
  "schema": "pocket-service-card/v1",
  "description": "Celestia mainnet (celestia). CometBFT RPC, Cosmos SDK REST and gRPC.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "CometBFT RPC, default :26657 (JSON-RPC mode: POST / with a jsonrpc envelope)"
    },
    {
      "type": "REST",
      "intent": "optional",
      "backend_hint": "cosmos REST (gRPC-gateway), default :1317"
    },
    {
      "type": "COMET_BFT",
      "intent": "optional",
      "backend_hint": "CometBFT RPC, default :26657 (URI style, GET /status)"
    },
    {
      "type": "WEBSOCKET",
      "intent": "optional",
      "backend_hint": "CometBFT RPC, same port at /websocket",
      "notes": "subscribe (tm.event='NewBlock', tx events)"
    },
    {
      "type": "GRPC",
      "intent": "optional",
      "backend_hint": "cosmos gRPC, default :9090"
    }
  ],
  "apis": [
    "cometbft-rpc",
    "cosmos-rest",
    "cosmos-grpc"
  ],
  "specs": [
    {
      "kind": "openapi",
      "api": "cometbft-rpc",
      "url": "https://raw.githubusercontent.com/cometbft/cometbft/v0.38.x/rpc/openapi/openapi.yaml",
      "notes": "Covers JSON_RPC (POST / envelope), COMET_BFT (URI style) and the /websocket subscriptions on :26657."
    },
    {
      "kind": "openapi",
      "api": "cosmos-rest",
      "url": "https://raw.githubusercontent.com/cosmos/cosmos-sdk/release/v0.50.x/client/docs/swagger-ui/swagger.yaml",
      "notes": "Generic Cosmos SDK swagger for this chain's SDK line; chain-specific modules are not covered, the chain publishes no swagger of its own."
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Celestia full node (celestia-appd) with RPC, REST/gRPC-gateway and gRPC enabled; pruning 'default' or lighter is fine for head-of-chain traffic.",
    "implementations": [
      "celestia-appd >= v9 (celestiaorg/celestia-app)"
    ],
    "docs": "https://github.com/celestiaorg/celestia-app",
    "sync": "full",
    "min_disk_gb": 2000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "status"
        },
        "expect": {
          "json_path": "$.result.node_info.network",
          "matches": "^celestia$"
        },
        "notes": "Chain-id assertion: guards against a node for a different network staked under this service id."
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "status"
        },
        "expect": {
          "json_path": "$.result.sync_info.catching_up",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "health"
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^\\{\\}$"
        }
      },
      {
        "rpc_type": "REST",
        "request": {
          "path": "/cosmos/base/tendermint/v1beta1/syncing",
          "method": "GET"
        },
        "expect": {
          "json_path": "$.syncing",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "REST",
        "request": {
          "path": "/cosmos/base/tendermint/v1beta1/node_info",
          "method": "GET"
        },
        "expect": {
          "json_path": "$.default_node_info.network",
          "matches": "^celestia$"
        }
      },
      {
        "rpc_type": "COMET_BFT",
        "request": {
          "path": "/status",
          "method": "GET"
        },
        "expect": {
          "json_path": "$.result.node_info.network",
          "matches": "^celestia$"
        }
      }
    ],
    "notes": "JSON_RPC here is CometBFT's JSON-RPC mode on the RPC port, the same server COMET_BFT addresses in URI style; websocket subscriptions are on that port at /websocket. Consensus node only (celestia-app); DA-layer bridge/light nodes are a different API and not this service. One supplier today. No gateway health check configured yet."
  },
  "docs": "https://docs.celestia.org/",
  "updated": "2026-09-03"
}
