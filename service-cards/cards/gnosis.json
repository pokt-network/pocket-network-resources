{
  "schema": "pocket-service-card/v1",
  "description": "Gnosis Chain mainnet JSON-RPC (chain id 100). xDai successor, Ethereum-equivalent PoS; eth_subscribe over websocket.",
  "rpc_types": [
    {
      "type": "JSON_RPC",
      "intent": "expected",
      "backend_hint": "execution client HTTP RPC, default :8545"
    },
    {
      "type": "WEBSOCKET",
      "intent": "expected",
      "backend_hint": "execution client WS RPC, default :8546",
      "notes": "eth_subscribe (newHeads, logs)"
    }
  ],
  "apis": [
    "ethereum-json-rpc",
    "eth-subscribe"
  ],
  "specs": [
    {
      "kind": "openrpc",
      "api": "ethereum-json-rpc",
      "url": "https://raw.githubusercontent.com/ethereum/execution-apis/assembled-spec/openrpc.json"
    }
  ],
  "access": "public",
  "results": "deterministic",
  "serving": {
    "backend": "Gnosis execution client paired with a Gnosis consensus client (lighthouse, teku, nimbus or lodestar).",
    "implementations": [
      "nethermind >= 1.27",
      "erigon >= 2.60",
      "geth >= 1.14"
    ],
    "docs": "https://docs.gnosischain.com/node/",
    "sync": "archive",
    "min_disk_gb": 2000,
    "healthcheck": [
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "eth_chainId",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x64$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "eth_syncing",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^false$"
        }
      },
      {
        "rpc_type": "JSON_RPC",
        "request": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "eth_getBalance",
          "params": [
            "0xe91d153e0b41518a2ce8dd3d7944fa863463a97d",
            "0x1312d00"
          ]
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x1faf6c098f2d065917389b$"
        },
        "notes": "Archival probe: historical balance at block 20000000. A pruned node returns a missing-trie-node error."
      },
      {
        "rpc_type": "WEBSOCKET",
        "request": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "eth_blockNumber",
          "params": []
        },
        "expect": {
          "json_path": "$.result",
          "matches": "^0x[0-9a-f]+$"
        },
        "notes": "Sends a request over the socket rather than only opening it: a handshake alone proves nothing."
      }
    ],
    "notes": "Archive state expected (gateway probes block 20000000)."
  },
  "docs": "https://docs.gnosischain.com/",
  "updated": "2026-09-03"
}
